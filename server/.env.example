PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/hcm_lite
MONGODB_DB=hcm_lite
CLIENT_URL=http://localhost:5173
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-secret
# Used once with `npm run bootstrap:super-admin`; never put this account through public signup.
SUPER_ADMIN_NAME=Platform Administrator
SUPER_ADMIN_EMAIL=platform-admin@example.com
SUPER_ADMIN_PASSWORD=replace-with-a-unique-password-at-least-14-chars
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
